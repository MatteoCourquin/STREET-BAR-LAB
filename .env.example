# Public URL of the site (used for canonicals, sitemap, OG images)
# Leave empty on Vercel without a custom domain: the *.vercel.app production URL is used automatically.
NEXT_PUBLIC_SITE_URL=

# Analytics — set one or more, leave empty to disable
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Google Search Console HTML-tag verification code (content="..." value)
GOOGLE_SITE_VERIFICATION=
