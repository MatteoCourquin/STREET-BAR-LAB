# Public URL of the site (used for canonicals, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://streetbarlab.com

# Analytics — set one or more, leave empty to disable
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Google Search Console HTML-tag verification code (content="..." value)
GOOGLE_SITE_VERIFICATION=

# Newsletter: POST target that receives {"email": "..."} as JSON (Brevo/Mailchimp/Zapier webhook...)
# Leave empty and the form shows a "coming soon" message instead of collecting emails.
NEWSLETTER_WEBHOOK_URL=
