# Public URL of the site (canonicals, sitemap, OG images). Defaults to https://streetbarlab.com in production builds.
NEXT_PUBLIC_SITE_URL=

# Analytics — set one or more, leave empty to disable
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Google Search Console HTML-tag verification code (content="..." value)
GOOGLE_SITE_VERIFICATION=
